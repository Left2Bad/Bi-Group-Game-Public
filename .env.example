DATABASE_PATH=./data/academy.sqlite
# Set true for HTTPS deployments (e.g. Coolify). Leave false for local HTTP.
COOKIE_SECURE=false
# Public site origin for proxies/browsers without Fetch Metadata (no path).
# PUBLIC_ORIGIN=https://academy.example.com
# Server-only OpenAI key. Dynamic assessment cannot start without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none, low, medium, high, xhigh, max; default omits reasoning in the request.
OPENAI_REASONING_EFFORT=high
# Translation of generated content (kk/en). Defaults: OPENAI_MODEL and reasoning low.
# OPENAI_TRANSLATION_MODEL=gpt-6-luna
# OPENAI_TRANSLATION_REASONING_EFFORT=low
